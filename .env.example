# Copy the variables you need into your host's environment settings.
# The binary reads the process environment; it does not load this file itself.

PORTFOLIO_ADDR=:8080
PORTFOLIO_BASE_URL=https://tanvirs.alwaysdata.net
PORTFOLIO_LOG_LEVEL=info
PORTFOLIO_LOG_FORMAT=json
PORTFOLIO_TRUSTED_PROXIES=127.0.0.1,::1
PORTFOLIO_HSTS=false
# Landing-page centrepiece: organism (default) or request. Takes effect on the next page load.
PORTFOLIO_HERO=organism
# Show the "Ask my portfolio" section.
PORTFOLIO_ASK=true

# PostgreSQL for the contact form and /admin (optional; both are off without it).
DATABASE_URL=postgres://user:password@localhost:5432/portfolio?sslmode=disable
# The single admin login, seeded at startup (password: 12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12
