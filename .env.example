# Copy the variables you need into your host's environment settings.
# The binary reads the process environment; it does not load this file itself.

PORTFOLIO_ADDR=:8080
PORTFOLIO_BASE_URL=https://tanvirs.alwaysdata.net
PORTFOLIO_LOG_LEVEL=info
PORTFOLIO_LOG_FORMAT=json
PORTFOLIO_TRUSTED_PROXIES=127.0.0.1,::1
PORTFOLIO_HSTS=false

# Contact form (optional). All three of SMTP_HOST, SMTP_FROM and CONTACT_TO enable it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
SMTP_TLS=starttls
